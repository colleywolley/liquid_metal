        <button id="mute-btn" class="icon-btn" type="button" title="Toggle metallic chimes (M)" aria-label="Toggle sound" aria-pressed="false">
          <svg id="icon-sound-on" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/></svg>
          <svg id="icon-sound-off" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" hidden><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>
        </button>
        <button id="settings-btn" class="icon-btn" type="button" title="Settings & filters" aria-label="Open settings and filters" aria-expanded="false">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>
        </button>
      </div>
    </header>

    <!-- Left Settings & Filter Drawer -->
    <aside id="settings" class="panel settings-drawer" hidden aria-label="Map settings and filters">
      <div class="panel-header">
        <span class="panel-kicker">FOUNDRY CONTROLS &amp; FILTERS</span>
        <button id="settings-close" class="icon-btn icon-btn-xs" type="button" aria-label="Close settings">×</button>
      </div>

      <div class="settings-body">
        <section class="settings-section">
          <div class="section-label-row">
            <h3>Process Families</h3>
            <button id="cat-reset" class="text-link" type="button" hidden>Show all</button>
          </div>
          <div id="category-legend" class="category-legend"></div>
        </section>

        <section class="settings-section">
          <div class="section-label-row">
            <h3>Filter by Substrate</h3>
            <button id="filter-clear" class="text-link" type="button" hidden>Clear</button>
          </div>
          <div id="material-chips" class="chip-cloud"></div>
        </section>

        <section class="settings-section">
          <h3>Filter by Performance</h3>
          <div id="performance-chips" class="chip-cloud"></div>
        </section>

        <section class="settings-section">
          <h3>Filter by Pioneer Location</h3>
          <div id="location-chips" class="chip-cloud"></div>
        </section>

        <section class="settings-section">
          <h3>Alloy Links</h3>
          <div class="segmented" role="radiogroup" aria-label="Alloy link density">
            <button type="button" data-links="off">Off</button>
            <button type="button" data-links="closest">Closest</button>
            <button type="button" data-links="nearest3" class="active">Nearest 3</button>
          </div>
        </section>

        <section class="settings-section">
          <div class="section-label-row">
            <h3>Studio Optics</h3>
            <button id="design-reset" class="text-link" type="button">Reset optics</button>
          </div>
          <label class="slider-row">
            <span>Orb size</span>
            <input id="opt-star-size" type="range" min="0.5" max="1.9" step="0.05" value="1" />
          </label>
          <label class="slider-row">
            <span>Specular glow</span>
            <input id="opt-bloom" type="range" min="0" max="1.2" step="0.02" value="0.34" />
          </label>
          <label class="slider-row">
            <span>Link brightness</span>
            <input id="opt-links-alpha" type="range" min="0.05" max="0.85" step="0.05" value="0.28" />
          </label>
        </section>

        <section class="settings-section">
          <h3>How to explore</h3>
          <dl class="cheat-sheet">
            <div><dt>Drag</dt><dd>Orbit 3D foundry</dd></div>
            <div><dt>Shift + Drag</dt><dd>Pan camera</dd></div>
            <div><dt>Scroll / Pinch</dt><dd>Zoom in &amp; out</dd></div>
            <div><dt>F / 0 / M / Esc</dt><dd>Search · Reset · Sound · Close</dd></div>
          </dl>
        </section>
      </div>
    </aside>

    <!-- Right Details Drawer (#card) -->
    <aside id="card" class="panel details-card" hidden aria-label="Finish details">
      <div class="card-top">
        <div class="category-chip">
          <span class="dot" id="card-dot"></span>
          <span id="card-category">ANODIZING</span>
        </div>
        <div class="card-top-actions">
          <button id="card-share" class="icon-btn icon-btn-xs" type="button" title="Copy share link" aria-label="Copy share link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
          </button>
          <button id="card-close" class="icon-btn icon-btn-xs" type="button" title="Close (Esc)" aria-label="Close details">×</button>
        </div>
      </div>

      <h2 id="card-title">Finish Name</h2>
      <p id="card-meta" class="card-meta">#1 of 55 in versatility</p>
      <div id="card-metal-badge" class="metal-finish-badge" hidden>
        <span class="metal-swatch-orb" id="card-metal-swatch" aria-hidden="true"></span>
        <span id="card-metal-label">24K Liquid Gold</span>
      </div>

      <div class="card-scroll">
        <!-- Product Photography Showcase -->
        <div id="card-photo-wrap" class="photo-showcase" hidden>
          <button id="card-photo-btn" class="photo-hero-btn" type="button" aria-label="Expand product photography">
            <img id="card-photo" class="photo-hero" src="" alt="" loading="lazy" />
            <span class="photo-zoom-badge" aria-hidden="true">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
              Inspect
            </span>
          </button>
          <div id="card-thumbs" class="photo-thumbs" hidden></div>
        </div>

        <div class="card-actions">
          <div class="card-actions-row">
            <a id="card-ext-link" class="action-pill action-pill-primary" href="#" target="_blank" rel="noopener noreferrer">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              <span id="card-ext-label">Process Page</span>
            </a>
            <a class="action-pill action-pill-quote" href="https://www.pioneermetal.com/request-a-quote/" target="_blank" rel="noopener noreferrer">
              <span>Request a Quote</span>
            </a>
          </div>
          <div class="card-actions-row">
            <button id="card-overlaps" class="action-pill" type="button">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="12" r="6"/><circle cx="15" cy="12" r="6"/></svg>
              <span>See overlaps</span>
            </button>
            <button id="card-journey" class="action-pill" type="button">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="19" r="3"/><path d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15"/><circle cx="18" cy="5" r="3"/></svg>
              <span>Journey to…</span>
            </button>
          </div>
        </div>

        <!-- Producing Pioneer Facilities (from 2026 Facility Specific Line Cards) -->
        <div id="card-locations-block" class="card-section">
          <h3>PRODUCED AT THESE PIONEER SITES</h3>
          <div id="card-locations" class="site-card-list"></div>
        </div>

        <!-- General Information & Overview -->
        <div class="card-section">
          <h3>ABOUT THIS FINISH</h3>
          <div id="card-process-type" class="process-type-badge"></div>
          <p id="card-summary" class="card-summary"></p>
        </div>

        <!-- Industries, Iconic OEMs & Metallurgy Inventor Heritage -->
        <div id="card-heritage-block" class="card-section">
          <h3>INDUSTRIES, MAJOR BRANDS &amp; HERITAGE</h3>
          <div id="card-industries" class="heritage-industries"></div>
          <div id="card-brands" class="heritage-brands"></div>
          <div class="heritage-inventor-box">
            <div id="card-inventor" class="heritage-inventor-name"></div>
            <p id="card-origin" class="heritage-inventor-origin"></p>
          </div>
        </div>

        <!-- Key Facts -->
        <div id="card-facts-block" class="card-section" hidden>
          <h3>KEY FACTS &amp; HIGHLIGHTS</h3>
          <ul id="card-facts" class="facts-list"></ul>
        </div>

        <div id="card-materials-block" class="card-section">
          <h3>COMPATIBLE SUBSTRATES</h3>
          <div id="card-materials" class="trait-grid"></div>
        </div>

        <div id="card-performances-block" class="card-section">
          <h3>PERFORMANCE PROPERTIES</h3>
          <div id="card-performances" class="trait-grid"></div>
        </div>

        <div id="card-specs-block" class="card-section" hidden>
          <h3>STANDARDS &amp; SPECS</h3>
          <div id="card-specs" class="spec-row"></div>
        </div>

        <div class="card-section">
          <h3>NEARBY FINISHES</h3>
          <ol id="card-neighbors" class="neighbor-list"></ol>
        </div>
      </div>
    </aside>

    <!-- Right Journey Route Drawer (#journey) -->
    <aside id="journey" class="panel details-card" hidden aria-label="Journey route between finishes">
      <div class="card-top">
        <div class="category-chip">
          <span class="dot" style="background: #f0b44c; box-shadow: 0 0 8px #f0b44c;"></span>
          <span>ALLOY ROUTE</span>
        </div>
        <div class="card-top-actions">
          <button id="journey-share" class="icon-btn icon-btn-xs" type="button" title="Copy route link" aria-label="Copy route link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
          </button>
          <button id="journey-close" class="icon-btn icon-btn-xs" type="button" title="Close route (Esc)" aria-label="Close route">×</button>
        </div>
      </div>

      <h2 id="journey-title">Finish A → Finish B</h2>
      <p id="journey-meta" class="card-meta">4 finishes · 3 steps</p>

      <div class="journey-controls">
        <button id="journey-prev" class="pill-btn pill-btn-sm" type="button">‹ Prev</button>
        <button id="journey-play" class="pill-btn pill-btn-sm pill-btn-accent" type="button">▶ Auto-play</button>
        <button id="journey-next" class="pill-btn pill-btn-sm" type="button">Next ›</button>
      </div>

      <div class="card-scroll">
        <ol id="journey-steps" class="journey-steps"></ol>
      </div>
    </aside>

    <!-- Bottom Floating HUD -->
    <footer class="hud bottom">
      <div class="attribution">
        <a href="https://www.pioneermetal.com/" target="_blank" rel="noopener noreferrer">Pioneer Metal Finishing</a> ·
        <a href="https://www.pioneermetal.com/locations/" target="_blank" rel="noopener noreferrer">Locations</a> ·
        <a href="https://www.pioneermetal.com/contact/" target="_blank" rel="noopener noreferrer">Contact Us</a>
        <span class="brand-pillars" aria-label="Your Specs, Your Schedule, Your Security">
          <span><strong>YOUR</strong> SPECS</span>
          <span><strong>YOUR</strong> SCHEDULE</span>
          <span><strong>YOUR</strong> SECURITY</span>
        </span>
      </div>
      <a id="embed-expand" class="embed-expand" href="#" target="_blank" rel="noopener noreferrer" hidden>
        Open Full Map ↗
      </a>

      <div class="bottom-center">
        <!-- Active Filter / Drift / Tour Pill (#now) -->
        <div id="now" class="now-pill" hidden aria-live="polite">
          <div class="eq" aria-hidden="true"><span></span><span></span><span></span></div>
          <div class="now-text">
            <div id="now-title" class="now-title">Drifting</div>
            <div id="now-sub" class="now-sub">Anodizing</div>
          </div>
          <div class="now-actions" id="now-actions"></div>
          <div class="now-progress" id="now-progress" hidden><span id="now-progress-fill"></span></div>
        </div>

        <div id="hint" class="hint">
          scroll to zoom · drag to orbit · shift-drag to pan · click a liquid metal orb to inspect
        </div>
      </div>

      <button id="reset-btn" class="icon-btn" type="button" title="Center and zoom out (0)" aria-label="Center and zoom out">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="7"/><circle cx="12" cy="12" r="2"/><line x1="12" y1="2" x2="12" y2="5"/><line x1="12" y1="19" x2="12" y2="22"/><line x1="2" y1="12" x2="5" y2="12"/><line x1="19" y1="12" x2="22" y2="12"/></svg>
      </button>
    </footer>

    <!-- Product Photography Lightbox Dialog (closedby="any" light-dismiss) -->
    <dialog id="lightbox" class="lightbox-dialog" closedby="any" aria-labelledby="lightbox-title">
      <div class="lightbox-header">
        <div>
          <h2 id="lightbox-title">Finish Photo</h2>
          <p id="lightbox-sub" class="lightbox-sub"></p>
        </div>
        <button id="lightbox-close" class="icon-btn icon-btn-xs" type="button" aria-label="Close photo preview">×</button>
      </div>
      <div class="lightbox-stage">
        <img id="lightbox-img" src="" alt="" />
      </div>
      <div id="lightbox-thumbs" class="lightbox-thumbs" hidden></div>
    </dialog>

    <!-- Toast Notification -->
    <div id="toast" class="toast" hidden role="status" aria-live="polite"></div>

  </body>
</html>
